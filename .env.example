# ===================================================
# Ejecución local (pnpm run dev / npm run dev)
# MongoDB corriendo en la máquina local
# ===================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27017/auth-db

# ===================================================
# Ejecución dentro de Docker Compose
# El hostname debe coincidir con el container_name
# del servicio mongodb definido en docker-compose.yml
# ===================================================
# MONGODB_URI=mongodb://auth-mongodb:27017/auth-db

# ===================================================
# Credenciales de MongoDB (requeridas en Docker)
# ===================================================
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# ===================================================
# API metadata (usada por Swagger/OpenAPI)
# ===================================================
API_TITLE=Auth Microservice API
API_DESCRIPTION=Autenticación, gestión de usuarios y emisión de API Keys — TFM SaaS Reconocimiento Facial
