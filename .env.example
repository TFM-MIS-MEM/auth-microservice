# ===================================================
# Ejecución local (pnpm run dev / npm run dev)
# MongoDB corriendo en la máquina local
# ===================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Sin valor por omisión: el servicio RECHAZA ARRANCAR si falta. Antes tomaba
# esta misma URI por defecto, de modo que un despliegue sin configurar se
# levantaba contra otra base de datos sin dar un solo error.
MONGODB_URI=mongodb://localhost:27017/auth-db

# ===================================================
# JWT — Autenticación con tokens de sesión
# Generar un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===================================================
JWT_SECRET=change_me_with_a_64_byte_random_hex_string
# Vigencia de la sesión web. El servicio RECHAZA ARRANCAR con un valor fuera
# del rango de 5 minutos a 2 horas: por debajo el panel resulta inusable, por
# encima deja de sostenerse el argumento de la ventana de revocación que
# documenta la memoria. Acepta segundos ("3600") o sufijo ("60m", "1h").
JWT_EXPIRES_IN=1h

# ===================================================
# Email Service (Resend) & Frontend setup
# ===================================================
RESEND_API_KEY=re_your_resend_api_key_here
# Sin valor por omisión: el servicio RECHAZA ARRANCAR si falta. Va dentro del
# enlace del correo de recuperación de contraseña, así que un defecto rompe la
# recuperación de cuenta sin que nada lo registre como fallo.
FRONTEND_URL=http://localhost:3000

# ===================================================
# Security M2M — Comunicación interna entre microservicios
#
# Protege POST /v1/auth/validate-key, que NO se expone a través de la pasarela.
# El servicio RECHAZA ARRANCAR si falta, si está vacío o si vale uno de los
# literales publicados en este repositorio —incluido el marcador de abajo—:
# un secreto que consta en el código no es un secreto. Véase
# src/config/internalSecret.js.
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Tiene que coincidir con SPACE_AUTH_INTERNAL_SECRET de api-gateway, que es
# quien lo presenta. `scripts/dev-up.sh` genera el par y comprueba que casan.
# ===================================================
INTERNAL_API_SECRET=change_me_with_a_64_byte_random_hex_string

# ===================================================
# Ejecución dentro de Docker Compose
# El hostname debe coincidir con el container_name
# del servicio mongodb definido en docker-compose.yml
# ===================================================
# MONGODB_URI=mongodb://auth-mongodb:27017/auth-db

# ===================================================
# Credenciales de MongoDB (requeridas en Docker)
# ===================================================
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# ===================================================
# API metadata (usada por Swagger/OpenAPI)
# ===================================================
API_TITLE=Auth Microservice API
API_DESCRIPTION=Autenticación, gestión de usuarios y emisión de API Keys — TFM SaaS Reconocimiento Facial
